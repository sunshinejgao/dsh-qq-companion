# 复制成 .env 后填写；不要把 .env 提交到仓库
# ── 必需 ────────────────────────────────────────────────
# qq-bridge 的部署目录（里面应有 src/ roles/ state/ config.json）
QQ_BRIDGE_DIR=<你的 qq-bridge 目录，例如 D:\QQ\qq-bridge>
# DeepSeek Harness 可执行文件
DSH_EXE=<DSH 的 exe 路径，例如 E:\dpsk\DeepSeek Harness.exe>
# 跑 RVC 的 Python（装了 torch + rvc-python 的环境）
PY_RVC=<RVC 环境的 python.exe>
# 跑 TTS 与小工具用的 Python
PY_CORE=<基础环境的 python.exe>
# ffmpeg 可执行文件
FFMPEG=<ffmpeg.exe 路径>

# ── 可选（有默认值）──────────────────────────────────────
# 翻唱成品存档目录（建议做成 junction 指向仓库内 covers/，避免沙箱写不进桌面）
# COVER_DIR=<存档目录>
# 中间文件目录
# VOICE_WORK=<工作目录>
# 分段/试音产物目录
# VOICE_OUT=<输出目录>
# OneBot HTTP 接口
# ONEBOT_API=http://127.0.0.1:3000
# SnowLuma 令牌文件（默认取 qq-bridge 目录下的 snowluma-token.txt）
# SNOWLUMA_TOKEN_FILE=<token 文件路径>
# 兜底群号（群聊里会显式传 group）
# DEFAULT_GROUP=<群号>
# RVC 音色目录名
# VOICE_MODEL=naxida
# COVER_MODEL=naxida
# RVC 模型根目录（内含 <音色名>/xxx.pth + xxx.index）
# RVC_MODELS_DIR=<voice-models 目录>
# RVC_PORT=8127
# 豆包 TTS 凭据（JSON：{"appid":"...","token":"..."}）
# VOLC_CRED=<volc-app.json 路径>
# 狗头军师 skill 目录
# JUNSHI_DIR=<repo>/vendor/goutoujunshi
# 日记目录
# DIARY_DIR=<repo>/data/diary
# 洛雪音乐 CDP 端口 / 下载目录
# LX_CDP_PORT=9222
# LX_DOWNLOAD_DIR=<洛雪下载目录>